{
  "name": "paperhands-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @paperhands/frontend",
    "build": "npm run build --workspace @paperhands/frontend",
    "start": "npm run start --workspace @paperhands/frontend",
    "build:contract": "near-sdk-js build contracts/paperhands_arena/src/contract.ts build/paperhands_arena.wasm",
    "test:arena": "node --test scripts/arena.test.js"
  },
  "devDependencies": {
    "near-sdk-js": "2.0.0"
  },
  "overrides": {
    "@types/node": "18.19.0"
  }
}
